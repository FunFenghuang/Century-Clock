// Tao mat na nhap nhay cho digit dang duoc chinh
// Khi co truong dang chinh, digit tuong ung se nhap nhay (sang/tat moi 500ms)
// Khi khong chinh gi, tat ca digit deu sang binh thuong

module blink_selector (
    input  wire       clk_50MHz,
    input  wire       rst_n,
    input  wire       tick_blink,       // Xung 2Hz de tao nhap nhay
    input  wire       mode,     // 0: DATE, 1: TIME
    input  wire [2:0] edit_selected,   // Truong dang duoc chon de chinh
    output reg  [7:0] blink_mask        // Mat na cho 8 digit (1=sang, 0=tat)
);

    // Ma truong - giong edit_field_selector
    localparam FIELD_NONE   = 3'b000;
    localparam FIELD_DAY    = 3'b001;
    localparam FIELD_MONTH  = 3'b010;
    localparam FIELD_YEAR   = 3'b011;
    localparam FIELD_HOUR   = 3'b100;
    localparam FIELD_MINUTE = 3'b101;
    localparam FIELD_SECOND = 3'b110;

    // Trang thai nhap nhay: dao moi khi tick_1hz
    reg blink_state;

    always @(posedge clk_50MHz or negedge rst_n) begin
        if (!rst_n) begin
            blink_state <= 1'b1;
        end
        else begin
            if (tick_blink) begin
                blink_state <= ~blink_state;
            end
        end
    end

    // Tao mat na blink dua tren truong dang chinh
    // Vi tri digit tren LED 7 doan:
    //   TIME mode: SEG7=H10, SEG6=H1, SEG5=M10, SEG4=M1, SEG3=S10, SEG2=S1, SEG1=off, SEG0=off
    //   DATE mode: SEG7=D10, SEG6=D1, SEG5=M10, SEG4=M1, SEG3=Y1000, SEG2=Y100, SEG1=Y10, SEG0=Y1
    always @(*) begin
        blink_mask = 8'b11111111;       // Mac dinh tat ca sang

        if (edit_selected != FIELD_NONE && blink_state == 1'b0) begin
            case (edit_selected )
                // TIME mode fields - chi nhap nhay khi mode = 1 (TIME)
                FIELD_SECOND: begin
                    if (mode == 1'b1) begin
                        blink_mask[3] = 1'b0;   // SEG3 (S10) nhap nhay
                        blink_mask[2] = 1'b0;   // SEG2 (S1)  nhap nhay
                    end
                end
                FIELD_MINUTE: begin
                    if (mode == 1'b1) begin
                        blink_mask[5] = 1'b0;   // SEG5 (M10) nhap nhay
                        blink_mask[4] = 1'b0;   // SEG4 (M1)  nhap nhay
                    end
                end
                FIELD_HOUR: begin
                    if (mode == 1'b1) begin
                        blink_mask[7] = 1'b0;   // SEG7 (H10) nhap nhay
                        blink_mask[6] = 1'b0;   // SEG6 (H1)  nhap nhay
                    end
                end

                // DATE mode fields - chi nhap nhay khi mode = 0 (DATE)
                FIELD_DAY: begin
                    if (mode == 1'b0) begin
                        blink_mask[7] = 1'b0;   // SEG7 (D10) nhap nhay
                        blink_mask[6] = 1'b0;   // SEG6 (D1)  nhap nhay
                    end
                end
                FIELD_MONTH: begin
                    if (mode == 1'b0) begin
                        blink_mask[5] = 1'b0;   // SEG5 (M10) nhap nhay
                        blink_mask[4] = 1'b0;   // SEG4 (M1)  nhap nhay
                    end
                end
                FIELD_YEAR: begin
                    if (mode == 1'b0) begin
                        blink_mask[3] = 1'b0;   // SEG3 (Y1000) nhap nhay
                        blink_mask[2] = 1'b0;   // SEG2 (Y100)  nhap nhay
                        blink_mask[1] = 1'b0;   // SEG1 (Y10)   nhap nhay
                        blink_mask[0] = 1'b0;   // SEG0 (Y1)    nhap nhay
                    end
                end

                default: ;                  // Khong nhap nhay
            endcase
        end
    end

endmodule
